{
  "permissions": {
    "allow": [
      "Edit",
      "Bash(pytest *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": ["Bash(git push *)"],
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
              "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plan-status.sh"
          }
        ]
      }
    ]
  }
}
